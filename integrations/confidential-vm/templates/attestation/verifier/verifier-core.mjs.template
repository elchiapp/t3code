// @ts-nocheck — verbatim copy of deploy/privacy-center/verifier-core.mjs (parity-tested)
// Turing Privacy Verification Center — client-side evidence evaluator.
//
// Dependency-free (WebCrypto only) so the exact same source runs in the
// HAPI web panel, the standalone pinned verifier page and Node tests.
// A JSON boolean from the server is never accepted as proof: every domain
// either verifies cryptographic evidence locally or reports an honest
// unverified/failed/unavailable state.
//
// Nothing in this module claims that TLS/Tailscale, a mounted LUKS volume or
// an SNP launch measurement proves custody of the running HAPI/Codex
// containers or of the browser session.

export const PROTOCOL = 'turing-privacy-evidence-v1';
export const VERIFIER_BUILD = 'privacy-center-1';

export const STATE = Object.freeze({
  VERIFIED: 'verified',
  FAILED: 'failed',
  EXPIRED: 'expired',
  UNAVAILABLE: 'unavailable',
  UNVERIFIED: 'unverified',
  CHECKING: 'checking' // UI-only: core never returns it
});

export const DOMAINS = Object.freeze([
  {id: 'verifier-client-trust', title: 'Verifier / client trust',
   summary: 'This verifier was delivered through an independent pinned channel, not by the HAPI origin it checks.'},
  {id: 'nonce-replay', title: 'Fresh nonce & replay protection',
   summary: 'The evidence answers a fresh browser-generated challenge, is TLS-side tamper-evident via a signed transcript and cannot be replayed.'},
  {id: 'snp-hardware-firmware', title: 'GCP AMD SEV-SNP hardware & firmware',
   summary: 'A Google-signed Confidential Space workload token proves the hardware model and debug-off state.'},
  {id: 'secure-boot-vtpm', title: 'Secure Boot, vTPM & measured boot',
   summary: 'The workload token claims Secure Boot enabled since boot; the token itself exists only through the vTPM-backed launcher.'},
  {id: 'approved-workload', title: 'Approved HAPI/Codex workload & release',
   summary: 'Running image digests and configuration match the pinned release manifest, proven by the measured launcher — not self-reported.'},
  {id: 'session-key-binding', title: 'Attestation ↔ browser session binding',
   summary: 'The attestation transcript commits to this browser tab’s ephemeral session key, origin and release policy.'},
  {id: 'luks-storage', title: 'LUKS storage & attestation-gated key release',
   summary: 'The storage key was released only to the attested approved workload; a mounted disk alone does not prove this.'},
  {id: 'tinfoil-enclave', title: 'Tinfoil enclave code measurement & release',
   summary: 'Independent, Milan-compatible client-side verification of the Tinfoil enclave measurement against its approved release.'},
  {id: 'tinfoil-hpke-channel', title: 'Tinfoil HPKE encrypted inference channel',
   summary: 'The VM→Tinfoil leg is HPKE-encrypted to the verified enclave key; observable by this verifier only via official verification evidence.'},
  {id: 'evidence-freshness', title: 'Evidence freshness & revocation',
