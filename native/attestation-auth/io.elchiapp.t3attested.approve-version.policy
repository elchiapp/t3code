<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>T3 Attested</vendor>
  <vendor_url>https://github.com/elchiapp/t3code</vendor_url>
  <action id="io.elchiapp.t3attested.approve-version">
    <description>Approve a reviewed confidential-computing build in T3 Attested</description>
    <message>Authenticate to approve the exact build shown in T3 Attested.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
