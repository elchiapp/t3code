import {lstatSync,readFileSync,mkdirSync,writeFileSync,renameSync,unlinkSync} from 'node:fs';
import {homedir} from 'node:os';
import {join,dirname} from 'node:path';
import {randomBytes} from 'node:crypto';
import {validateVersionDecisions} from './verifier/version-decisions.mjs';

export function deviceApprovalPath() {
  const root = process.platform === 'darwin' ? join(homedir(),'Library','Application Support') :
    process.platform === 'win32' ? (process.env.APPDATA || join(homedir(),'AppData','Roaming')) :
    (process.env.XDG_CONFIG_HOME || join(homedir(),'.config'));
  return join(root,'T3 Attested','attestation-versions.json');
}

export function readDeviceDecisions(path=deviceApprovalPath()) {
  let stat;
  try { stat=lstatSync(path); } catch (error) { if(error.code==='ENOENT')return null;throw error; }
  if (!stat.isFile() || stat.size > 65536 || (process.platform !== 'win32' &&
      (stat.uid !== process.getuid() || (stat.mode & 0o077))))
    throw Error('The device approval file is not protected.');
  return validateVersionDecisions(JSON.parse(readFileSync(path,'utf8')));
}

// Only a native client may call this after device authentication and fresh proof review.
export function writeDeviceDecisions(decisions,path=deviceApprovalPath()) {
  const rows=validateVersionDecisions({version:1,decisions});
  readDeviceDecisions(path);
  const directory=dirname(path);
  mkdirSync(directory,{recursive:true,mode:0o700});
  const parent=lstatSync(directory);
  if (!parent.isDirectory() || (process.platform !== 'win32' && parent.uid !== process.getuid()))
    throw Error('The device approval directory is not trusted.');
  const temporary=join(directory,'.version-decision-'+randomBytes(16).toString('hex')+'.tmp');
  try {
    writeFileSync(temporary,JSON.stringify({version:1,decisions:rows},null,2)+'\n',{mode:0o600,flag:'wx'});
    renameSync(temporary,path);
  } finally {
    try{unlinkSync(temporary);}catch(error){if(error.code!=='ENOENT')throw error;}
  }
}
