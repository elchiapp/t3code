#!/usr/bin/env python3
"""Forward loopback traffic to the existing verified gateway; never log bodies."""
import asyncio
import ipaddress
import json

CONTAINER = "turing-codex-inference-1"
NETWORK = "turing-codex_agent"
LIMIT = asyncio.Semaphore(64)


async def destination():
    process = await asyncio.create_subprocess_exec(
        "/usr/bin/docker", "inspect", "--format", "{{json .NetworkSettings.Networks}}",
        CONTAINER, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
    )
    output, _ = await asyncio.wait_for(process.communicate(), 5)
    if process.returncode:
        raise ConnectionError("Verified gateway unavailable")
    address = json.loads(output)[NETWORK]["IPAddress"]
    if not ipaddress.ip_address(address).is_private:
        raise ConnectionError("Unexpected gateway network")
    return address, 3401


async def copy(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    finally:
        writer.close()


async def handle(reader, writer):
    upstream = None
    try:
        async with LIMIT:
            host, port = await destination()
            remote_reader, upstream = await asyncio.wait_for(asyncio.open_connection(host, port), 5)
            tasks = [asyncio.create_task(copy(reader, upstream)), asyncio.create_task(copy(remote_reader, writer))]
            _, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
            for task in pending:
                task.cancel()
            await asyncio.gather(*tasks, return_exceptions=True)
    except (ConnectionError, OSError, TimeoutError, ValueError, KeyError):
        # Fail closed. There is no alternate inference destination.
        pass
    finally:
        writer.close()
        if upstream is not None:
            upstream.close()


async def main():
    server = await asyncio.start_server(handle, "127.0.0.1", 3412, backlog=64)
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    asyncio.run(main())
