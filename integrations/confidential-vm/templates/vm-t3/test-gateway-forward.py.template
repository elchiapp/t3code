#!/usr/bin/env python3
"""Real TCP checks with synthetic data; no provider or VM connection."""
import asyncio
import importlib.util
from pathlib import Path

spec = importlib.util.spec_from_file_location('gateway', Path(__file__).with_name('gateway-forward.py'))
gateway = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gateway)


async def main():
    received = asyncio.get_running_loop().create_future()
    wire = b'POST /v1/responses HTTP/1.1\r\nHost: loopback\r\nContent-Length: 2\r\n\r\n{}'
    response = b'HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK'

    async def upstream(reader, writer):
        received.set_result(await reader.readexactly(len(wire)))
        writer.write(response)
        await writer.drain()
        writer.close()

    server = await asyncio.start_server(upstream, '127.0.0.1', 0)
    port = server.sockets[0].getsockname()[1]

    async def target():
        return '127.0.0.1', port

    gateway.destination = target
    proxy = await asyncio.start_server(gateway.handle, '127.0.0.1', 0)
    proxy_port = proxy.sockets[0].getsockname()[1]
    reader, writer = await asyncio.open_connection('127.0.0.1', proxy_port)
    writer.write(wire)
    await writer.drain()
    assert await asyncio.wait_for(reader.read(), 3) == response
    assert await received == wire
    writer.close()
    await writer.wait_closed()

    async def unavailable():
        raise ConnectionError('Synthetic gateway outage')

    gateway.destination = unavailable
    reader, writer = await asyncio.open_connection('127.0.0.1', proxy_port)
    writer.write(wire)
    await writer.drain()
    try:
        assert await asyncio.wait_for(reader.read(), 3) == b''
    except ConnectionResetError:
        # Closing a socket with an unread request may send TCP RST instead of FIN.
        pass
    writer.close()
    try:
        await writer.wait_closed()
    except ConnectionResetError:
        pass
    proxy.close()
    server.close()
    await proxy.wait_closed()
    await server.wait_closed()
    print('PASS: byte-exact forwarding; unavailable gateway closes without fallback')


if __name__ == '__main__':
    asyncio.run(main())
