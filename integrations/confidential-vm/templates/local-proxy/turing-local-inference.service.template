[Unit]
Description=Owner-only Tailscale entry to the verified Tinfoil gateway
After=turing-t3-gateway.service tailscaled.service
Requires=turing-t3-gateway.service

[Service]
Type=simple
User=turing
Group=turing
ExecStart={{VM_T3_ROOT}}/current/bin/node {{VM_LOCAL_PROXY_ROOT}}/owner-proxy.mjs {{VM_LOCAL_PROXY_ROOT}}/config.json
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=128
LimitCORE=0
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
