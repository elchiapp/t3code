import {test} from 'node:test';import assert from 'node:assert/strict';
import {chatResponseStream} from './chat-stream.mjs';import {toChatRequest} from './responses-chat.mjs';
const packet=v=>'data: '+JSON.stringify(v)+'\n\n';
const decode=s=>JSON.parse(s.split('\ndata: ')[1]);
async function collect(frames,options={}){const body=new ReadableStream({start(c){for(const f of frames)c.enqueue(new TextEncoder().encode(f));c.close();}});const out=[];for await(const s of chatResponseStream(body,'synthetic',options.custom??new Set(),options.names??new Map(),options.schemas??new Map()))out.push(decode(s));return out;}
test('Requests genuine Chat streaming and usage',()=>{const x=toChatRequest({model:'synthetic',input:'test',stream:true});assert.equal(x.request.stream,true);assert.equal(x.request.stream_options.include_usage,true);assert.equal(toChatRequest({model:'synthetic',input:'test'}).request.stream,false);});
test('Reasoning and text reach reader before body completion',async()=>{let controller;const body=new ReadableStream({start(c){controller=c;}});const it=chatResponseStream(body,'synthetic',new Set(),new Map(),new Map());assert.equal(decode((await it.next()).value).type,'response.created');controller.enqueue(new TextEncoder().encode(packet({choices:[{delta:{reasoning_content:'Plan'}}]})));assert.equal(decode((await it.next()).value).type,'response.output_item.added');assert.equal(decode((await it.next()).value).delta,'Plan');controller.enqueue(new TextEncoder().encode(packet({choices:[{delta:{content:'Hello'}}]})));await it.next();await it.next();assert.equal(decode((await it.next()).value).delta,'Hello');controller.enqueue(new TextEncoder().encode(packet({choices:[{delta:{},finish_reason:'stop'}]})+'data: [DONE]\n\n'));controller.close();const rest=[];for await(const v of it)rest.push(decode(v));const final=rest.at(-1).response;assert.equal(final.output[0].content[0].text,'Plan');assert.equal(final.output[1].content[0].text,'Hello');});
test('Fragmented UTF8/CRLF frames and usage survive',async()=>{const text=packet({choices:[{delta:{content:'世界'}}]}).replaceAll('\n','\r\n');const bytes=new TextEncoder().encode(text+packet({choices:[{delta:{},finish_reason:'stop'}],usage:{prompt_tokens:7,completion_tokens:5,total_tokens:12,completion_tokens_details:{reasoning_tokens:2}}}));const body=new ReadableStream({start(c){for(const b of bytes)c.enqueue(new Uint8Array([b]));c.close();}});let final;for await(const v of chatResponseStream(body,'synthetic',new Set(),new Map(),new Map()))final=decode(v);assert.equal(final.response.output[0].content[0].text,'世界');assert.equal(final.response.usage.output_tokens,5);assert.equal(final.response.usage.output_tokens_details.reasoning_tokens,2);});
test('Tool namespaces/typed booleans are preserved before execution',async()=>{const names=new Map([['ns__f',{namespace:'ns',name:'f'}]]),schemas=new Map([['ns__f',{type:'object',properties:{ok:{type:'boolean'}}}]]);const out=await collect([packet({choices:[{delta:{tool_calls:[{index:0,id:'call1',function:{name:'ns__f',arguments:'{"ok":'}}]}}]}),packet({choices:[{delta:{tool_calls:[{index:0,function:{arguments:'"true"}'}}]},finish_reason:'tool_calls'}]})],{names,schemas});const f=out.at(-1).response.output[0];assert.equal(f.namespace,'ns');assert.equal(f.name,'f');assert.deepEqual(JSON.parse(f.arguments),{ok:true});});
test('Premature/incomplete streams fail instead of claiming completion',async()=>{await assert.rejects(()=>collect([packet({choices:[{delta:{content:'partial'}}]})]));await assert.rejects(()=>collect(['data: {']));});

test('Token limit is incomplete with partial text, usage and no executable tool',async()=>{
 const out=await collect([packet({choices:[{delta:{content:'partial',tool_calls:[{index:0,id:'call1',function:{name:'f',arguments:'{'}}]}}]}),packet({choices:[{delta:{},finish_reason:'length'}],usage:{prompt_tokens:3,completion_tokens:2,total_tokens:5}}),'data: [DONE]\n\n']);
 assert.equal(out.at(-1).type,'response.incomplete');assert.equal(out.at(-1).response.status,'incomplete');assert.equal(out.at(-1).response.incomplete_details.reason,'max_output_tokens');assert.equal(out.at(-1).response.usage.output_tokens,2);assert.equal(out.at(-1).response.output.length,1);assert.equal(out.at(-1).response.output[0].content[0].text,'partial');assert.ok(!out.some(e=>e.type==='response.completed'||e.type==='response.function_call_arguments.delta'));
});
test('Filtered completion is incomplete and missing usage is not invented',async()=>{
 const out=await collect([packet({choices:[{delta:{content:'partial'},finish_reason:'content_filter'}]})]);assert.equal(out.at(-1).type,'response.incomplete');assert.equal(out.at(-1).response.incomplete_details.reason,'content_filter');assert.equal(out.at(-1).response.usage,null);
});
test('DONE alone or an unknown finish cannot report success',async()=>{
 await assert.rejects(()=>collect([packet({choices:[{delta:{content:'partial'}}]}),'data: [DONE]\n\n']));await assert.rejects(()=>collect([packet({choices:[{delta:{},finish_reason:'unknown'}]})]));
});
